# ============================================================
# Personal Workbench - 环境变量配置
# ============================================================
# 用法：复制此文件为 .env 并修改值
#   cp .env.example .env
# docker compose 会自动读取同目录下的 .env 文件
# ============================================================

# 前端对外访问端口（默认 8080）
# 修改后访问地址为 http://localhost:<PORT>
PORT=8080
